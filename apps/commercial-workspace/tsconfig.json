{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@bondly/pricing-engine": ["../../packages/pricing-engine/src/index.ts"],
      "@bondly/pricing-types": ["../../packages/pricing-types/src/index.ts"],
      "@bondly/pricing-catalog": ["../../packages/pricing-catalog/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
