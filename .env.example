# Bondly Commercial Platform — variáveis de ambiente (somente o auth-proxy lê estas variáveis)
#
# Plataforma-agnóstico (AWS/Render/Docker). NUNCA commitar valores reais.
# Segredos: injete via Secrets Manager/SSM (AWS), painel da plataforma ou .env local NÃO versionado.
# NADA aqui é prefixado por VITE_ — qualquer VITE_* iria para o bundle público do cliente.
# Legenda: [SEGREDO] = nunca em log/repo; [CONFIG] = não sensível.

# --- Servidor / rede ---
# [CONFIG] Padrão REAL do código = 10000 (apps/auth-proxy/src/config.ts). O valor abaixo é
# só para dev local (8799); em contêiner/produção use 10000 ou ajuste target group/health check.
PORT=8799
# [CONFIG] G-013: ALLOWLIST {development,test} (case/espaços normalizados). QUALQUER outro valor (ausente,
# staging, prod, Production...) = PRODUÇÃO: cookies Secure e EXIGE DATA_DIR, SESSION_SECRET, GOOGLE_*, PUBLIC_URL.
# O valor abaixo é SÓ para dev local; em staging/produção use NODE_ENV=production.
NODE_ENV=development
# [CONFIG] URL pública REAL (https em produção, atrás de ALB/CloudFront). Compõe o redirect_uri:
# PUBLIC_URL + /auth/callback (deve bater EXATAMENTE com o cadastrado no Google).
PUBLIC_URL=http://127.0.0.1:8799
# [CONFIG] Caminho do dist do SPA (padrão: ../commercial-workspace/dist relativo ao módulo).
STATIC_DIR=../commercial-workspace/dist

# --- Persistência (SQLite via node:sqlite, Node 22+) ---
# [CONFIG] Diretório do arquivo SQLite. DEVE apontar para volume persistente (ex.: EBS montado em /data).
# G-003: em PRODUÇÃO (qualquer NODE_ENV fora de {development,test}, inclusive ausente) SEM DATA_DIR, ou com SQLite inacessível, o servidor
# RECUSA SUBIR (exit 1) — não cai mais em memória. Fora de produção o fallback em memória continua.
# Instância ÚNICA (SQLite não é multi-instância). Ver docs/13-deploy-aws-manual.md.
DATA_DIR=
# [CONFIG] Opt-in EXPLÍCITO para repositório em memória em produção (dados PERDIDOS a cada restart,
# /healthz sinaliza ephemeral). NÃO USAR EM PRODUÇÃO REAL — só demo/preview descartável. Default false.
ALLOW_EPHEMERAL_REPO=false

# --- Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID, tipo Web) ---
# [CONFIG] público
GOOGLE_CLIENT_ID=
# [SEGREDO]
GOOGLE_CLIENT_SECRET=

# --- Sessão ---
# [SEGREDO] Assina o cookie de sessão (HMAC). Comando recomendado (qualquer um serve):
#   openssl rand -hex 32            # 64 hex = 256 bits
#   openssl rand -hex 16            # 32 hex = 128 bits (mínimo)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# G-019/G-032: em produção (NODE_ENV fora de {development,test}) o boot é RECUSADO se o valor for o
# default de dev público, tiver < 32 caracteres, for periódico (repetição de uma unidade de até 16 chars),
# for sequência (alfabeto/dígitos/teclado) ou palavra de dicionário, OU tiver força estimada < 128 bits.
# A força é length x log2(alfabeto-fonte): hex de alfabeto pequeno é aceito (openssl rand -hex 16 = 128 bits).
SESSION_SECRET=

# --- RBAC: atribuição INDIVIDUAL de perfil (business | tech | approver | admin) ---
# [CONFIG, sem segredo] E-mails (separados por vírgula) promovidos a admin NO BOOT, somente se ainda
# não existir nenhum admin. Cada e-mail precisa estar num domínio autorizado (inválidos são descartados
# e só a contagem é logada). Depois do 1º admin, os demais perfis são geridos pela tela/API de admin.
BOOTSTRAP_ADMIN_EMAILS=
# [CONFIG] DEPRECATED. true reativa o fluxo legado de código de perfil compartilhado (/api/profile/unlock,
# nunca concede approver). Default false. NÃO ligar em produção.
LEGACY_PROFILE_CODES=false
# [CONFIG] G-008: em NODE_ENV=production a flag acima é RECUSADA (log error) a menos que este ack seja true.
# INSEGURO POR DESIGN (código compartilhado). Só para transição controlada; loga warn no boot.
LEGACY_PROFILE_CODES_ACK_INSECURE=false

# --- (DEPRECATED, só com LEGACY_PROFILE_CODES=true) 2º fator por código de perfil ---
# hash scrypt do código; opcional, papel sem hash fica inatingível.
# [SEGREDO] Gere cada hash com:  node scripts/gen-profile-hash.mjs 'codigo-em-texto-puro'
# e cole a saída (scrypt$...) aqui. Nunca versione o código em texto puro nem o hash.
PROFILE_CODE_HASH_BUSINESS=
PROFILE_CODE_HASH_TECH=
PROFILE_CODE_HASH_ADMIN=
